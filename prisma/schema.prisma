generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String?   // null for Google OAuth users
  googleId        String?   @unique
  role            String    @default("USER")
  slug            String?   @unique  // URL-friendly identifier, e.g. "kelechi-oji"
  bio             String?
  photo           String?
  emailVerified   Boolean   @default(false)
  verifyToken     String?
  resetToken      String?
  resetTokenExp   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  isMentor        Boolean   @default(false)
  mentorBio       String?
  isWriter        Boolean   @default(false)

  posts           Post[]
  comments        Comment[]
  likes           Like[]
  commentLikes    CommentLike[]
  nominations     Nomination[]
  newsletter      Newsletter?

  mentorRequestsReceived MentorshipRequest[] @relation("MentorRequests")
  mentorRequestsSent     MentorshipRequest[] @relation("MenteeRequests")
  notifications          Notification[]
  followers              Follow[]            @relation("UserFollowing")
  following              Follow[]            @relation("UserFollowers")

  crProgress             CRReadingProgress[]
  crShelves              CRShelfItem[]
  crPlans                CRReadingPlan[]
  crComments             CRComment[]
  crReactions            CRReaction[]

  @@map("users")
}

// Role enum removed for SQLite

model Post {
  id          String      @id @default(uuid())
  title       String
  slug        String?     @unique  // URL-friendly identifier for the post
  subtitle    String?
  body        String
  excerpt     String?
  tags        String?
  coverImage  String?
  status      String      @default("PENDING")
  rejectReason String?
  views       Int         @default(0)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  approvedAt  DateTime?

  challengeId String?
  challenge   Challenge?  @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  comments    Comment[]
  likes       Like[]

  @@map("posts")
}

// PostStatus enum removed for SQLite

model Comment {
  id        String   @id @default(uuid())
  body      String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  guestName String?
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  likes     CommentLike[]
  createdAt DateTime @default(now())

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@unique([commentId, guestId])
  @@map("comment_likes")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@unique([postId, guestId])
  @@map("likes")
}

model Newsletter {
  id           String   @id @default(uuid())
  email        String   @unique
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscribedAt DateTime @default(now())

  @@map("newsletter")
}

model Nomination {
  id            String   @id @default(uuid())
  bookTitle     String
  bookAuthor    String
  reason        String?
  submitterId   String
  submitter     User     @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  submittedAt   DateTime @default(now())

  @@map("nominations")
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String
  theme       String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  posts       Post[]

  @@map("challenges")
}

model MentorshipRequest {
  id          String   @id @default(uuid())
  mentorId    String
  mentor      User     @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId    String
  mentee      User     @relation("MenteeRequests", fields: [menteeId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  message     String?
  createdAt   DateTime @default(now())

  @@map("mentorship_requests")
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // 'SYSTEM', 'MENTORSHIP', 'CHALLENGE', 'POST_STATUS'
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("notifications")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

// ========================================================================
// CHAPTER ROOM MODELS (Pass 4)
// ========================================================================

model CRBook {
  id              String               @id @default(uuid())
  slug            String               @unique
  title           String
  author          String
  year            Int?
  genre           String
  genres          String?
  coverImage      String?
  readingTime     String
  chapterCount    Int                  @default(1)
  difficulty      String
  difficultyNote  String?
  recommendRate   Int                  @default(90)
  isBotm          Boolean              @default(false)
  botmMonth       String?
  tagline         String?
  description     String
  whyWeAreReading String?
  keyThemes       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt

  chapters        CRChapter[]
  progress        CRReadingProgress[]
  shelves         CRShelfItem[]
  plans           CRReadingPlan[]

  @@map("cr_books")
}

model CRChapter {
  id               String      @id @default(uuid())
  bookId           String
  book             CRBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  number           Int
  title            String
  readingTime      String
  readingPanelText String?
  summary          String
  keyIdeas         String?
  discussionPrompt String?
  createdAt        DateTime    @default(now())

  comments         CRComment[]

  @@unique([bookId, number])
  @@map("cr_chapters")
}

model CRReadingProgress {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId            String
  book              CRBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  currentChapter    Int       @default(1)
  completedChapters String    @default("[]")
  status            String    @default("currently-reading")
  abandonReason     String?
  reflection        String?
  wouldRecommend    Boolean?
  startedAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@unique([userId, bookId])
  @@map("cr_reading_progress")
}

model CRShelfItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      CRBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  shelf     String   // 'currentlyReading', 'nextUp', 'wishlist', 'finished', 'abandoned'
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, bookId])
  @@map("cr_shelf_items")
}

model CRReadingPlan {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  book       CRBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  targetDate DateTime
  frequency  String
  createdAt  DateTime @default(now())

  @@map("cr_reading_plans")
}

model CRComment {
  id             String        @id @default(uuid())
  chapterId      String
  chapter        CRChapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  guestName      String?
  text           String
  isSpoiler      Boolean       @default(false)
  spoilerSummary String?
  parentId       String?
  parent         CRComment?    @relation("CRCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        CRComment[]   @relation("CRCommentReplies")
  isHidden       Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  reactions      CRReaction[]
  reports        CRReport[]

  @@index([chapterId])
  @@map("cr_comments")
}

model CRReaction {
  id        String    @id @default(uuid())
  commentId String
  comment   CRComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?
  type      String    // 'interesting', 'madeMeThink', 'excellentPoint', 'iDisagree'
  createdAt DateTime  @default(now())

  @@unique([commentId, userId, type])
  @@unique([commentId, guestId, type])
  @@map("cr_reactions")
}

model CRReport {
  id         String    @id @default(uuid())
  commentId  String
  comment    CRComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String?
  category   String    // 'Spoilers without tag', 'Harassment or hate speech', etc.
  details    String?
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status])
  @@map("cr_reports")
}

