generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  password        String?   // null for Google OAuth users
  googleId        String?   @unique
  role            String    @default("USER")
  slug            String?   @unique  // URL-friendly identifier, e.g. "kelechi-oji"
  bio             String?
  photo           String?
  emailVerified   Boolean   @default(false)
  verifyToken     String?
  resetToken      String?
  resetTokenExp   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  isMentor        Boolean   @default(false)
  mentorBio       String?
  isWriter        Boolean   @default(false)

  posts           Post[]
  comments        Comment[]
  likes           Like[]
  nominations     Nomination[]
  newsletter      Newsletter?

  mentorRequestsReceived MentorshipRequest[] @relation("MentorRequests")
  mentorRequestsSent     MentorshipRequest[] @relation("MenteeRequests")

  @@map("users")
}

// Role enum removed for SQLite

model Post {
  id          String      @id @default(uuid())
  title       String
  slug        String?     @unique  // URL-friendly identifier for the post
  subtitle    String?
  body        String
  excerpt     String?
  tags        String?
  coverImage  String?
  status      String      @default("PENDING")
  rejectReason String?
  views       Int         @default(0)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  approvedAt  DateTime?

  challengeId String?
  challenge   Challenge?  @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  comments    Comment[]
  likes       Like[]

  @@map("posts")
}

// PostStatus enum removed for SQLite

model Comment {
  id        String   @id @default(uuid())
  body      String
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("likes")
}

model Newsletter {
  id           String   @id @default(uuid())
  email        String   @unique
  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscribedAt DateTime @default(now())

  @@map("newsletter")
}

model Nomination {
  id            String   @id @default(uuid())
  bookTitle     String
  bookAuthor    String
  reason        String?
  submitterId   String
  submitter     User     @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  submittedAt   DateTime @default(now())

  @@map("nominations")
}

model Challenge {
  id          String   @id @default(uuid())
  title       String
  description String
  theme       String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  posts       Post[]

  @@map("challenges")
}

model MentorshipRequest {
  id          String   @id @default(uuid())
  mentorId    String
  mentor      User     @relation("MentorRequests", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId    String
  mentee      User     @relation("MenteeRequests", fields: [menteeId], references: [id], onDelete: Cascade)
  status      String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  message     String?
  createdAt   DateTime @default(now())

  @@map("mentorship_requests")
}
